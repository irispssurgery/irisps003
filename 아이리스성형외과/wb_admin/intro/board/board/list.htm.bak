if ($Check_Box) // 게시판 공지사항
{	
		$query="select list_top,list_del from ezboard where no=$Check_Box";
		$row=$inst->ExecFetch($query);
		$top=trim($row[list_top]);

		if ($row[list_del]=='yes'){
			echo("
				<script>
					window.alert('삭제된 게시물은 공지글로 등록할 수 없습니다.')
					history.go(-1)
				</script>
			");
			exit;
		}

		if ($top=='yes'){
			$top ='no';
		}else if ($top=='no'){
			$top ='yes';		
		}	

		$query="update ezboard set list_top='$top' where no=$Check_Box";
		$inst->Execute($query);
		echo("<meta http-equiv='refresh' content='0;url=list.htm?db=$db&go_it=$go_it'>");
}


if ($Check_Box2)
{
		$query="select list_del from ezboard where no=$Check_Box2";
		$del=$inst->ExecValue($query);
		if ($del=='yes'){
			$del ='no';
		}else if ($del=='no'){
			$del ='yes';		
		}
		$query="update ezboard set list_del='$del' where no=$Check_Box2";
		$inst->Execute($query);	
		echo("<meta http-equiv='refresh' content='0;url=list.htm?db=$db&go_it=$go_it'>");
}

