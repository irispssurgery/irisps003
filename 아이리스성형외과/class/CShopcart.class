		}

		function getOrderList($settle)
		{
			global $PAGE;

			if(!$settle)
				return false;

			if(!$PAGE)
				$this->PAGE=1;
			else
				$this->PAGE=$PAGE;

			$GET_RECORD=10;
			$START_RECORD=($this->PAGE-1)*$GET_RECORD;

			$query="SELECT * FROM jumun WHERE settle='".$settle."' ORDER BY idx DESC LIMIT ".$START_RECORD.", ".$GET_RECORD."";
			$result=$this->db->ExecuteDML($query);

			while($resultSet=$this->db->FetchArray($result))
			{
				$recordSet[]=$resultSet;
			}

			return $recordSet;
		}

