		function getMinValueCard($seperator, $site_code, $call_type)
		{
			if(!$seperator || !$site_code || !$call_type)
				return false;

			$query="SELECT min(ch.".$call_type.") FROM charge_manager cm, card_charge ch WHERE cm.seperator='".$seperator."' AND cm.isview='1' AND cm.site_code='".$site_code."' AND cm.card_name=ch.card_code AND ch.pattern='nopay' AND ch.".$call_type."<>0";

			$result=$this->db->ExecuteDML($query);

			return $this->db->getResult($result, 0, 0);
		}

