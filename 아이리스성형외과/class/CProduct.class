			$query="SELECT * FROM card_charge WHERE site_code='".$site_code."' AND card_code='".$card_code."'";
			$result=$this->db->ExecuteDML($query);

			while($resultSet=$this->db->FetchArray($result))
			{
				$recordSet[]=$resultSet;
			}

			return $recordSet;
		}

		function getCardCharge($site_code, $card_code, $column)
