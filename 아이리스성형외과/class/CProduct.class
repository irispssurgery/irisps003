		function getPropertyCard($from_nation, $send_call_type, $take_call_type, $quality, $handle, $site_code)
		{
			$card_query="SELECT card_name FROM charge_manager WHERE seperator='".$from_nation."' AND isview='1' AND site_code='".$site_code."'";
			$result=$this->db->ExecuteDML($card_query);
		
			$want_value=$send_call_type."".$take_call_type."_value";

			$init=0;
	
			while($resultSet=$this->db->FetchArray($result))
			{
				if($init==0)
					$cards_list[]="'".$resultSet["card_name"]."'";
				else
					$cards_list[]=",'".$resultSet["card_name"]."'";
			}

			$cards=implode(",", $cards_list);

			$want_query="SELECT min(".$want_value.") FROM card_charge WHERE card_code IN (".$cards.") AND pattern='nopay' AND ".$want_value."<>0";

			$want_result=$this->db->ExecuteDML($want_query);

			$min_value=$this->db->getResult($want_result, 0, 0);

			$c_query="SELECT card_code FROM card_charge WHERE ".$want_value."=".$min_value." AND pattern='nopay' AND site_code='".$site_code."'";
			$c_result=$this->db->ExecuteDML($c_query);
			$card_code=$this->db->getResult($c_result, 0, 0);
			
			$data["want_value"]=$min_value;
			$data["card_code"]=$card_code;

			return $data;
		}

		function getCardBySite($site)
		{
			if(!$site)
				return false;

			$query="SELECT * FROM card_name WHERE site_code='".$site_code."'";
			$result=$this->db->ExecuteDML($query);

			while($resultSet=$this->db->FetchArray($result))
			{
				$recordSet[]=$resultSet;
			}

			return $recordSet;
		}
	}	
