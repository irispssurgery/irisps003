		function UpdateCharge($data)
		{
			if(!$data)
				return false;

			while(list($key, $value)=each($data))
			{
				$cols[]="".$key."=".$value."";
			}

			$column=implode(",", $cols);

			$query="UPDATE card_charge SET ".$column." WHERE card_name='".$data["card_name"]."' AND site_code='".$data["site_code"]."'";
			$result=$this->db->ExecuteDML($query);

			if(!$result)
				return false;
			else
				return true;
		}

		function getCardCode($idx)
		{
			if(!$idx)
				return false;

			$query="SELECT card_name FROM charge_manager WHERE idx=".$idx."";
			$result=$this->db->ExecuteDML($query);

			$card_name=$this->db->getResult($result, 0, 0);

			return $card_name;
		}

		function parseData($data)
		{
			if(!$data)
				return false;

			$start_pos=1;

			foreach($data as $key => $value)
			{
				$value_column=explode("_", $key);
				$col[$value_column[0]."_".$value_column[1]]=$value;

				if($start_pos%4==0)
				{
					$col["card_code"]=$this->getCardCode($value_column[2]);
					$col["site_code"]=$data["site_code"];

					$result=$this->InputData($col);
				}
				
				$start_pos++;
			}

			if(!$result)
				return false;
			else
				return true;
		}

		function InputData($data)
		{
			if(!$data)
				return false;

			foreach($data as $key => $value)
			{
				if($key=="site_code" || $key=="card_code")
					$cols[]="".$key."='".$value."'";
				else
					$cols[]="".$key."=".$value."";
			}

			$column=implode(",", $cols);

			$query="UPDATE card_charge SET ".$column.", signdate=now() WHERE card_code='".$data["card_code"]."' AND site_code='".$data["site_code"]."'";
			$result=$this->db->ExecuteDML($query);

			if(!$result)
				return false;
			else
				return true;
		}

		function getCardChargeAll($site_code, $card_code)
		{
			if(!$site_code || !$card_code)
