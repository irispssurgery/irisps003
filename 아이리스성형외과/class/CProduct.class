		function CProduct()
		{
			global $db;

			if(!$db || !is_object($db))
				return false;

			$this->db=$db;
		}

		function ListProductAll($site_code)
		{
			if(!$site_code)
				return false;

			$query="SELECT * FROM card_name WHERE site_code='".$site_code."'";
			$result=$this->db->ExecuteDML($query);

			while($resultSet=$this->db->FetchArray($result))
			{
				$recordSet[]=$resultSet;
			}

			return $recordSet;
		}
		
