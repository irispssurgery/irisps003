		function insertMainStay($data)
		{
			if(!$data)
				return false;
			
			foreach($data as $key => $value)
			{
				$cols[]=$key;

				if($key=="kor_pay" || $key=="for_pay")
					$rows[]="".$value."";
				else
					$rows[]="'".$value."'";
			}

			$column=implode(",", $cols);
			$tuple=implode(",", $rows);

			$query="INSERT INTO mainstay (".$column.", signdate) VALUES (".$tuple.", now());";
			$result=$this->db->ExecuteDML($query);

			if(!$result)
				return false;
			else
				return true;
		}

		function updateMainStay($data)
		{
			if(!$data)
				return false;

			foreach($data as $key => $value)
			{
				if($key=="idx")
				{
					continue;
				}
				else
				{
					if($key=="kor_idx" || $key=="for_idx")
						$cols[]="".$key."=".$value."";
					else
						$cols[]="".$key."='".$value."'";
				}
			}

			$column=implode(",", $cols);

			$query="UPDATE mainstay SET ".$column." WHERE idx=".$data["idx"]."";
			$result=$this->db->ExecuteDML($query);

			if(!$result)
				return false;
			else
				return true;
		}

