		function geSunbulCardActiveDomestic($seperator, $site_code)
		{
			if(!$seperator || !$site_code)
				return false;

			$query="SELECT * FROM charge_manager WHERE seperator='".$seperator."' AND site_code='".$site_code."' AND isview='1'";
			$result=$this->db->ExecuteDML($query);

			while($resultSet=$this->db->FetchArray($result))
			{
				$card_name=explode("_", $resultSet["card_name"]);

				$is_pattern=$this->isPattern($card_name[0], $resultSet["site_code"]);
				
				if($is_pattern=="nopay")
					$recordSet[]=$resultSet;
			}

			return $recordSet;
		}

