			$query="SELECT ".$column." FROM card_charge WHERE card_code='".$card_code."' AND site_code='".$site_code."'";
			$result=$this->db->ExecuteDML($query);

			return $this->db->getResult($result, 0, 0);
		}

		function InputPin($data)
		{
			if(!$data)
				return false;

			foreach($data as $key => $value)
			{
				$cols[]=$key;
				
				if($key!="card_price")
					$rows[]="'".$value."'";
				else
					$rows[]="".$value."";
			}

			$column=implode(",", $cols);
			$tuple=implode(",", $rows);

			$query="INSERT INTO card_stock (".$column.") VALUES (".$tuple.");";
			$result=$this->db->ExecuteDML($query);

			if(!$result)
				return false;
			else
				return true;
		}

