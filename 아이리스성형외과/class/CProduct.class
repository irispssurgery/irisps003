		function updateOutPin($data)
		{
			if(!$data)
				return false;

			foreach($data as $key => $value)
			{
				if($key=="card_pin")
					continue;

				$sql[]="".$key."='".$value."'";
			}

			$sql_string=implode(",", $sql);
			$query="UPDATE card_stock SET ".$sql_string.", out_date=now(), sold_flag='Y' WHERE card_pin='".$data["card_pin"]."'";
			$result=$this->db->ExecuteDML($query);

			if(!$result)
				return false;
			else
				return true;
		}

		function minusCallBonus($user, $bonus)
		{
			if(!$user || !$bonus)
				return false;

			$query="UPDATE user_bonus SET addbonus=addbonus-".$bonus.", bonus=bonus-".$bonus.", usebonus=usebonus+".$bonus." WHERE user_id='".$user."'";
			$result=$this->db->ExecuteDML($query);

			if(!$result)
				return false;
			else
				return true;
		}

