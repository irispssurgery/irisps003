		function getMainCard($site_code, $seperator, $pattern_type)
		{
			if(!$site_code || !$seperator || !$pattern_type)
				return false;

			$query="SELECT * FROM charge_manager WHERE site_code='".$site_code."' AND seperator='".$seperator."' AND isview='1'";
			$result=$this->db->ExecuteDML($query);

			while($resultSet=$this->db->FetchArray($result))
			{
				$pattern=$this->isPattern($resultSet["card_name"], $resultSet["site_code"]);
				
				if($pattern==$pattern_type)
					$recordSet[]=$resultSet;

				if($pattern_type=="ALL")
					$recordSet[]=$resultSet;
			}

			return $recordSet;
		}

		function isPattern($card_name, $site_code)
		{
			if(!$site_code || !$card_name)
				return false;

			$query="SELECT pattern FROM card_name WHERE CID='".$card_name."' AND site_code='".$site_code."'";
			$result=$this->db->ExecuteDML($query);

			return $this->db->getResult($result, 0, 0);
		}

